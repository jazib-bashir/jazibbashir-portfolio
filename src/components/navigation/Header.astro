---
import { navItems, site } from '../../data/site';
import { withBase } from '../../utils/withBase';
import Icons from '../layout/Icons.astro';
---

<header class="site-header">
	<div class="page-container site-header__inner">
		<a class="site-header__brand" href={withBase('/')}>
			<span class="site-header__name">{site.name}</span>
		</a>
		<span class="site-header__title-badge">
			<span class="site-header__status-dot" aria-hidden="true"></span>
			<span>{site.title}</span>
		</span>

		<nav class="site-header__nav" aria-label="Primary">
			<ul class="site-header__links">
				{navItems.map((item) => (
					<li>
						<a href={item.href} class:list={[item.href === '#selected-projects' && 'is-active']}>{item.label}</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="site-header__actions">
			<button type="button" class="icon-btn" data-theme-toggle aria-pressed="false" aria-label="Switch theme">
				<span class="icon-btn__sun"><Icons name="sun" /></span>
				<span class="icon-btn__moon"><Icons name="moon" /></span>
			</button>
			<a class="site-header__cv" href={site.cvUrl}>
				<Icons name="download" />
				Download CV
			</a>
			<button
				type="button"
				class="icon-btn site-header__menu"
				data-nav-toggle
				aria-expanded="false"
				aria-controls="mobile-nav"
				aria-label="Open menu"
			>
				<Icons name="menu" />
			</button>
		</div>
	</div>

	<div id="mobile-nav" class="mobile-nav" data-nav-panel hidden>
		<nav class="page-container" aria-label="Mobile">
			<ul>
				{navItems.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))}
			</ul>
			<a class="btn btn--primary" href={site.cvUrl}>Download CV</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		height: 4rem;
		background: color-mix(in srgb, var(--color-surface-container-lowest) 80%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--color-border-subtle);
		box-shadow: 0 1px 3px 0 rgba(19, 27, 46, 0.03);
	}

	.site-header__inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: var(--space-md);
		height: 100%;
	}

	.site-header__brand {
		min-width: 0;
	}

	.site-header__name {
		font-family: var(--font-display);
		font-size: 18px;
		font-weight: 600;
		line-height: 26px;
		color: var(--color-text-primary);
		white-space: nowrap;
	}

	.site-header__name:hover {
		color: var(--color-primary);
	}

	.site-header__title-badge {
		display: none;
		align-items: center;
		gap: 0.375rem;
		padding: 0.125rem 0.5rem;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		color: var(--color-text-secondary);
		background: var(--color-surface-container-low);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		white-space: nowrap;
	}

	.site-header__status-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: var(--radius-full);
		background: var(--color-tertiary);
	}

	.site-header__nav {
		display: none;
		justify-self: center;
	}

	.site-header__links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-header__links a {
		padding: 0.375rem 0.75rem;
		font-size: 13px;
		font-weight: 500;
		color: var(--color-text-secondary);
		border-radius: var(--radius-lg);
		transition:
			color var(--transition-fast),
			background-color var(--transition-fast);
	}

	.site-header__links a:hover {
		color: var(--color-text-primary);
		background: var(--color-surface-container-low);
	}

	.site-header__links a.is-active {
		color: var(--color-text-primary);
		font-weight: 600;
		background: var(--color-surface-container-high, var(--color-surface-container));
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-sm);
	}

	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		color: var(--color-text-secondary);
		background: var(--color-surface-container);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.icon-btn:hover {
		color: var(--color-text-primary);
	}

	.icon-btn__sun,
	.icon-btn__moon {
		display: none;
	}

	html:not([data-theme='dark']) .icon-btn__sun {
		display: block;
	}

	html[data-theme='dark'] .icon-btn__moon {
		display: block;
	}

	.site-header__cv {
		display: none;
		align-items: center;
		gap: 0.375rem;
		padding: 0.375rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		color: var(--color-primary);
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-primary);
		border-radius: var(--radius-lg);
	}

	.site-header__cv:hover {
		background: var(--color-primary-container, var(--color-primary));
		color: var(--color-on-primary);
	}

	.site-header__menu {
		display: inline-flex;
	}

	.mobile-nav {
		position: fixed;
		top: 4rem;
		left: 0;
		right: 0;
		border-top: 1px solid var(--color-border-subtle);
		background: var(--color-surface-container-lowest);
	}

	.mobile-nav nav {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
		padding-block: var(--space-lg) var(--space-xl);
	}

	.mobile-nav ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: var(--space-md);
	}

	body.nav-open {
		overflow: hidden;
	}

	@media (min-width: 640px) {
		.site-header__title-badge {
			display: inline-flex;
		}

		.site-header__inner {
			grid-template-columns: auto auto 1fr auto;
		}
	}

	@media (min-width: 768px) {
		.site-header__nav {
			display: block;
		}

		.site-header__cv {
			display: inline-flex;
		}
	}

	@media (min-width: 1024px) {
		.site-header__menu {
			display: none;
		}

		.mobile-nav {
			display: none !important;
		}
	}
</style>
