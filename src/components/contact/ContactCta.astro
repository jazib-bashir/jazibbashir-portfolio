---
import { contact } from '../../data/contact';
import { site } from '../../data/site';
import Icons from '../layout/Icons.astro';
import PageSection from '../layout/PageSection.astro';
---

<PageSection id="contact-section" fullBleed ariaLabelledby="contact-heading" class="contact">
	<div class="contact__panel">
		<div class="contact__content">
			<p class="contact__badge">
				<span class="contact__badge-dot" aria-hidden="true"></span>
				<span class="contact__badge-light">{contact.availabilityLabel.light}</span>
				<span class="contact__badge-dark">{contact.availabilityLabel.dark}</span>
			</p>

			<h2 id="contact-heading" class="contact__title">{contact.title}</h2>

			<p class="contact__description body-lg">{contact.description}</p>

			<div class="contact__actions">
				<a class="contact__btn contact__btn--primary" href={contact.conversationUrl}>
					<Icons name="mail" />
					{contact.primaryButtonLabel}
				</a>
				<a class="contact__btn contact__btn--secondary" href={site.cvUrl}>
					<Icons name="download" />
					Download CV
				</a>
				<a class="contact__btn contact__btn--secondary" href={contact.linkedInUrl}>
					View LinkedIn
					<Icons name="external" />
				</a>
				<a class="contact__btn contact__btn--secondary" href={contact.upworkUrl}>
					View Upwork Profile
					<Icons name="external" />
				</a>
			</div>

			<p class="contact__status">
				<span class="contact__status-item">
					<span class="contact__status-dot" aria-hidden="true"></span>
					<span>{contact.status[0]}</span>
				</span>
				<span class="contact__status-sep" aria-hidden="true">•</span>
				<span>{contact.status[1]}</span>
				<span class="contact__status-sep" aria-hidden="true">•</span>
				<span>{contact.status[2]}</span>
			</p>
		</div>
	</div>
</PageSection>

<style>
	.contact {
		background: var(--contact-section-bg);
		border-bottom: none;
	}

	.contact__panel {
		--contact-gutter: var(--margin-page-sm);
		width: calc(100% - 2 * var(--contact-gutter));
		max-width: var(--layout-max);
		margin-inline: auto;
		padding-inline: var(--margin-page-sm);
		background: var(--contact-panel-bg);
		border: 1px solid var(--contact-panel-border);
		border-radius: var(--radius-lg);
	}

	.contact__content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-lg);
		padding-block: var(--space-2xl);
	}

	.contact__badge {
		display: inline-flex;
		align-items: center;
		gap: var(--space-sm);
		margin: 0;
		padding: 0.25rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 600;
		line-height: 16px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--contact-badge-text);
		background: var(--contact-badge-bg);
		border: 1px solid var(--contact-badge-border);
		border-radius: var(--radius-xl);
	}

	.contact__badge-dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: var(--radius-full);
		background: var(--contact-badge-text);
	}

	.contact__badge-dark {
		display: none;
	}

	html[data-theme='dark'] .contact__badge-light {
		display: none;
	}

	html[data-theme='dark'] .contact__badge-dark {
		display: inline;
	}

	.contact__title {
		margin: 0;
		max-width: 22rem;
		font-family: var(--font-display);
		font-size: clamp(28px, 4.2vw, 40px);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.025em;
		color: var(--color-text-primary);
	}

	.contact__description {
		margin: 0;
		max-width: 46rem;
		color: var(--color-text-secondary);
	}

	.contact__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-top: var(--space-xs);
	}

	.contact__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-sm);
		height: 42px;
		padding-inline: 1.5rem;
		font-size: 13px;
		font-weight: 600;
		line-height: 20px;
		border-radius: var(--radius-lg);
		border: 1px solid transparent;
		white-space: nowrap;
		transition:
			background-color var(--transition-fast),
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.contact__btn--primary {
		color: var(--color-on-primary);
		background: var(--color-primary);
		box-shadow: var(--shadow-sm);
	}

	.contact__btn--primary:hover {
		background: var(--color-primary-hover);
	}

	.contact__btn--secondary {
		color: var(--contact-btn-secondary-text);
		background: var(--contact-btn-secondary-bg);
		border-color: var(--contact-btn-secondary-border);
	}

	.contact__btn--secondary:hover {
		border-color: var(--color-border-strong);
		background: color-mix(in srgb, var(--contact-btn-secondary-bg) 85%, var(--color-surface-container));
	}

	.contact__status {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin: var(--space-md) 0 0;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		line-height: 16px;
		letter-spacing: 0.02em;
		color: var(--color-text-secondary);
	}

	.contact__status-item {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	.contact__status-sep {
		color: var(--color-text-muted);
	}

	.contact__status-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: var(--radius-full);
		background: var(--color-tertiary);
	}

	html[data-theme='dark'] .contact__panel {
		padding-inline: var(--space-lg);
	}

	@media (min-width: 768px) {
		.contact__panel {
			--contact-gutter: var(--margin-page);
			padding-inline: var(--margin-page);
		}

		.contact__title {
			max-width: 28rem;
		}

		html[data-theme='dark'] .contact__content {
			padding-block: var(--space-3xl);
		}
	}

	@media (min-width: 1024px) {
		.contact__panel {
			--contact-gutter: var(--margin-page-lg);
			padding-inline: var(--margin-page-lg);
		}

		.contact__content {
			padding-inline: 0;
		}
	}

	@media (max-width: 767px) {
		.contact__actions {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			max-width: 22rem;
		}

		.contact__btn {
			width: 100%;
		}
	}
</style>
