---
import PageSection from '../layout/PageSection.astro';
---

<PageSection tone="tint" padding="compact" class="hero-facts" ariaLabel="Resume quick facts">
	<div class="hero-facts__grid">
		<article class="hero-facts__card card">
			<div class="hero-facts__card-top">
				<span class="hero-facts__value">10+ Years</span>
			</div>
			<h2 class="hero-facts__label">Software Engineering</h2>
			<p class="hero-facts__text body-sm">
				Sustained commercial production delivery and architectural evolution.
			</p>
			<p class="hero-facts__foot">
				<span class="hero-facts__dot hero-facts__dot--primary"></span>
				Commercial Tenacity
			</p>
		</article>
		<article class="hero-facts__card card">
			<div class="hero-facts__card-top">
				<span class="hero-facts__value">Full-Stack</span>
			</div>
			<h2 class="hero-facts__label">Frontend + Backend</h2>
			<p class="hero-facts__text body-sm">
				Complete system awareness from component lifecycles to database internals.
			</p>
			<p class="hero-facts__foot hero-facts__foot--secondary">
				<span class="hero-facts__dot hero-facts__dot--secondary"></span>
				End-to-End Delivery
			</p>
		</article>
		<article class="hero-facts__card card">
			<div class="hero-facts__card-top">
				<span class="hero-facts__value">Product Eng</span>
			</div>
			<h2 class="hero-facts__label">SaaS + Enterprise</h2>
			<p class="hero-facts__text body-sm">
				Built, scaled, and managed across global healthcare, ed-tech, and logistics.
			</p>
			<p class="hero-facts__foot hero-facts__foot--tertiary">
				<span class="hero-facts__dot hero-facts__dot--tertiary"></span>
				Operational Scale
			</p>
		</article>
		<article class="hero-facts__card card">
			<div class="hero-facts__card-top">
				<span class="hero-facts__value">Tech Lead</span>
			</div>
			<h2 class="hero-facts__label">Product Ownership</h2>
			<p class="hero-facts__text body-sm">
				Translating messy real-world operational problems into structured software releases.
			</p>
			<p class="hero-facts__foot hero-facts__foot--primary-container">
				<span class="hero-facts__dot hero-facts__dot--primary-container"></span>
				Outcome Oriented
			</p>
		</article>
	</div>
</PageSection>

<style>
	.hero-facts__grid {
		display: grid;
		gap: var(--gutter);
		grid-template-columns: 1fr;
	}

	.hero-facts__card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-sm);
		padding: 1.25rem;
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-xl);
	}

	.hero-facts__value {
		font-family: var(--font-display);
		font-size: 28px;
		font-weight: 700;
		line-height: 36px;
		letter-spacing: -0.02em;
		color: var(--color-text-primary);
	}

	.hero-facts__label {
		margin: 0;
		font-family: var(--font-display);
		font-size: 18px;
		font-weight: 600;
		line-height: 26px;
		color: var(--color-text-primary);
	}

	.hero-facts__text {
		margin: 0;
		color: var(--color-text-secondary);
	}

	.hero-facts__foot {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin: var(--space-md) 0 0;
		padding-top: 0.5rem;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		color: var(--color-primary);
	}

	.hero-facts__foot--secondary {
		color: var(--color-secondary);
	}

	.hero-facts__foot--tertiary {
		color: var(--color-tertiary);
	}

	.hero-facts__foot--primary-container {
		color: var(--color-primary-container);
	}

	.hero-facts__dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: var(--radius-full);
		background: currentColor;
	}

	@media (min-width: 640px) {
		.hero-facts__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.hero-facts__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
