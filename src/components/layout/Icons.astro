---
export type IconName =
	| 'mail'
	| 'download'
	| 'arrow-right'
	| 'arrow-left'
	| 'menu'
	| 'close'
	| 'sun'
	| 'moon'
	| 'frontend'
	| 'data'
	| 'product'
	| 'engineering'
	| 'external'
	| 'arrow-down'
	| 'quote'
	| 'verified';

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className = '' } = Astro.props;
---

{
	name === 'mail' && (
		<svg class={className} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M2.5 4.5A1.5 1.5 0 0 1 4 3h8a1.5 1.5 0 0 1 1.5 1.5v7A1.5 1.5 0 0 1 12 13H4a1.5 1.5 0 0 1-1.5-1.5v-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
			<path d="m3.5 5 4.5 3.25L12.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	)
}
{
	name === 'download' && (
		<svg class={className} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M8 2v8m0 0 3-3m-3 3-3-3M3 12v1.5A1.5 1.5 0 0 0 4.5 15h7a1.5 1.5 0 0 0 1.5-1.5V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	)
}
{
	name === 'arrow-right' && (
		<svg class={className} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M3 8h10m0 0-3.5-3.5M13 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	)
}
{
	name === 'arrow-left' && (
		<svg class={className} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M13 8H3m0 0 3.5-3.5M3 8l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	)
}
{
	name === 'menu' && (
		<svg class={className} width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
			<path d="M4 6h12M4 10h12M4 14h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
		</svg>
	)
}
{
	name === 'close' && (
		<svg class={className} width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
			<path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
		</svg>
	)
}
{
	name === 'sun' && (
		<svg class={className} width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
			<circle cx="9" cy="9" r="3.25" stroke="currentColor" stroke-width="1.5"/>
			<path d="M9 1.5v1.5M9 15v1.5M1.5 9H3M15 9h1.5M3.4 3.4l1.06 1.06M13.54 13.54l1.06 1.06M3.4 14.6l1.06-1.06M13.54 4.46l1.06-1.06" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
		</svg>
	)
}
{
	name === 'moon' && (
		<svg class={className} width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
			<path d="M14.25 10.37a5.62 5.62 0 0 1-7.12-7.12A5.63 5.63 0 1 0 14.25 10.37Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
		</svg>
	)
}
{
	name === 'frontend' && (
		<svg class={className} width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
			<path d="M4 5.5h10M4 9h7M4 12.5h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			<rect x="2.5" y="2.5" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
		</svg>
	)
}
{
	name === 'data' && (
		<svg class={className} width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
			<ellipse cx="9" cy="5" rx="5.5" ry="2" stroke="currentColor" stroke-width="1.5"/>
			<path d="M3.5 5v4c0 1.1 2.46 2 5.5 2s5.5-.9 5.5-2V5M3.5 9v4c0 1.1 2.46 2 5.5 2s5.5-.9 5.5-2V9" stroke="currentColor" stroke-width="1.5"/>
		</svg>
	)
}
{
	name === 'product' && (
		<svg class={className} width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
			<path d="M3 6.5 9 3l6 3.5V12.5L9 16l-6-3.5V6.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
			<path d="M9 9.5 15 6.5M9 9.5v6.5M9 9.5 3 6.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
		</svg>
	)
}
{
	name === 'engineering' && (
		<svg class={className} width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
			<path d="M7.25 3.5 5 6.75l2.25 2.25L9.5 6.75 7.25 3.5ZM10.75 14.5 13 11.25 10.75 9 8.5 11.25l2.25 3.25Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
			<path d="m6.5 11.5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
		</svg>
	)
}
{
	name === 'external' && (
		<svg class={className} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M10 2h4v4M14 2 7 9M6 3H3.5A1.5 1.5 0 0 0 2 4.5v8A1.5 1.5 0 0 0 3.5 14h8a1.5 1.5 0 0 0 1.5-1.5V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	)
}
{
	name === 'arrow-down' && (
		<svg class={className} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M8 3v10m0 0 3.5-3.5M8 13l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	)
}
{
	name === 'quote' && (
		<svg class={className} width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
			<path d="M5 12c0-3 2-5 5-5V4C6 4 3 7 3 12v6h6v-6H5Zm10 0c0-3 2-5 5-5V4c-4 0-7 3-7 8v6h6v-6h-4Z" fill="currentColor"/>
		</svg>
	)
}
{
	name === 'verified' && (
		<svg class={className} width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
			<path d="M7.5 1.5 9 2.2l1.7-.3.8 1.6 1.5.9-.2 1.7 1.1 1.4-1.1 1.4.2 1.7-1.5.9-.8 1.6-1.7-.3-1.5.7-1.5-.7-1.7.3-.8-1.6-1.5-.9.2-1.7-1.1-1.4 1.1-1.4-.2-1.7 1.5-.9.8-1.6 1.7.3L7.5 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
			<path d="m5.5 7.5 1.5 1.5 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	)
}
