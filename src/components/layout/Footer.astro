---
import { navItems, site } from '../../data/site';
---

<footer class="site-footer">
	<div class="page-container site-footer__inner">
		<div class="site-footer__brand">
			<span class="site-footer__name">{site.name}</span>
			<span class="site-footer__dot" aria-hidden="true">•</span>
			<span class="site-footer__meta">Portfolio</span>
		</div>

		<nav class="site-footer__nav" aria-label="Footer">
			<ul>
				{navItems.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))}
			</ul>
		</nav>

		<p class="site-footer__copy">© {site.year} {site.name}. All rights reserved.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border-subtle);
		padding-block: var(--space-lg);
		background: var(--color-surface-container-lowest);
	}

	.site-footer__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-md);
		text-align: center;
	}

	.site-footer__brand {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.site-footer__name {
		font-family: var(--font-display);
		font-size: 18px;
		font-weight: 600;
		color: var(--color-text-primary);
	}

	.site-footer__dot,
	.site-footer__meta {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.site-footer__nav ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-md);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__nav a {
		font-size: 13px;
		color: var(--color-text-secondary);
		transition: color var(--transition-fast);
	}

	.site-footer__nav a:hover {
		color: var(--color-text-primary);
	}

	.site-footer__copy {
		margin: 0;
		font-size: 13px;
		color: var(--color-text-secondary);
	}

	@media (min-width: 640px) {
		.site-footer__inner {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
		}

		.site-footer__copy {
			text-align: right;
		}
	}
</style>
