---
import { skillCategories, skillsSection } from '../../data/skills';
import PageSection from '../layout/PageSection.astro';
import SectionHeader from '../layout/SectionHeader.astro';
import Icons from '../layout/Icons.astro';

const accentColor = {
	primary: 'var(--color-primary)',
	secondary: 'var(--color-secondary, #006780)',
	tertiary: 'var(--color-tertiary, #006243)',
};
---

<PageSection id="skills-section" tone="surface" ariaLabelledby="skills-heading">
	<SectionHeader
		label={skillsSection.label}
		title={skillsSection.title}
		description={skillsSection.description}
		titleId="skills-heading"
	/>

	<div class="expertise__grid">
		{skillCategories.map((category) => (
			<article class="expertise-card card">
				<div
					class="expertise-card__head"
					style={`--accent: ${accentColor[category.accent]}`}
				>
					<Icons name={category.icon} />
					<h3 class="headline-sm">{category.title}</h3>
				</div>
				<p class="expertise-card__description body-sm">{category.description}</p>
				<div class="expertise-card__tags">
					{category.technologies.map((tech) => (
						<span class="expertise-card__tag">{tech}</span>
					))}
				</div>
			</article>
		))}
	</div>
</PageSection>

<style>
	.expertise__grid {
		display: grid;
		gap: var(--space-lg);
	}

	.expertise-card {
		padding: var(--space-lg);
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.expertise-card__head {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		padding-bottom: var(--space-sm);
		border-bottom: 1px solid var(--color-border-subtle);
		color: var(--accent);
	}

	.expertise-card__head h3 {
		margin: 0;
		color: var(--color-text-primary);
	}

	.expertise-card__description {
		margin: 0;
		color: var(--color-text-secondary);
	}

	.expertise-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.expertise-card__tag {
		padding: 0.25rem 0.625rem;
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 16px;
		color: var(--color-text-primary);
		background: var(--color-surface-container-low);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
	}

	.body-sm {
		font-size: 13px;
		line-height: 20px;
	}

	@media (min-width: 768px) {
		.expertise__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.expertise__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
