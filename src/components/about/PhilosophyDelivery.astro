---
import { philosophySection } from '../../data/philosophy';
import PageSection from '../layout/PageSection.astro';
---

<PageSection id="ethos-section" tone="canvas" ariaLabelledby="philosophy-heading">
	<div class="philosophy__grid">
		<div class="philosophy__main">
			<p class="label-caps philosophy__label">{philosophySection.label}</p>
			<h2 id="philosophy-heading" class="headline-lg">{philosophySection.title}</h2>
			<p class="body-lg philosophy__description">{philosophySection.description}</p>
			<div class="philosophy__tags">
				{philosophySection.domainTags.map((tag) => (
					<span class="philosophy__tag">{tag}</span>
				))}
			</div>
		</div>

		<article class="philosophy__principles card card--elevated">
			<div class="philosophy__principles-head">
				<h3 class="headline-sm">{philosophySection.principlesTitle}</h3>
			</div>
			<ul class="philosophy__principles-list">
				{philosophySection.principles.map((principle) => (
					<li>
						<p class="philosophy__principle-title">
							<span class="philosophy__principle-dot" aria-hidden="true"></span>
							{principle.title}
						</p>
						<p class="body-sm philosophy__principle-desc">{principle.description}</p>
					</li>
				))}
			</ul>
		</article>
	</div>
</PageSection>

<style>
	.philosophy__grid {
		display: grid;
		gap: var(--space-xl);
		align-items: start;
	}

	.philosophy__main {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.philosophy__label {
		margin: 0;
		letter-spacing: 0.12em;
	}

	.philosophy__grid h2 {
		margin: 0;
	}

	.philosophy__description {
		margin: 0;
		max-width: 40rem;
		color: var(--color-text-secondary);
	}

	.philosophy__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-top: 0.5rem;
	}

	.philosophy__tag {
		padding: 0.375rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		color: var(--color-text-primary);
		background: var(--color-surface-container-low);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-lg);
	}

	.philosophy__principles {
		padding: var(--space-lg);
		background: var(--color-surface-container-lowest);
		box-shadow: var(--shadow-md);
	}

	.philosophy__principles-head {
		padding-bottom: var(--space-md);
		margin-bottom: var(--space-md);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.philosophy__principles-head h3 {
		margin: 0;
	}

	.philosophy__principles-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.philosophy__principle-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.25rem;
		font-size: 15px;
		font-weight: 700;
		color: var(--color-text-primary);
	}

	.philosophy__principle-dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: var(--radius-full);
		background: var(--color-primary);
		flex-shrink: 0;
	}

	.philosophy__principle-desc {
		margin: 0;
		padding-left: 0.875rem;
		color: var(--color-text-secondary);
	}

	.body-sm {
		font-size: 13px;
		line-height: 20px;
	}

	@media (min-width: 1024px) {
		.philosophy__grid {
			grid-template-columns: 7fr 5fr;
			gap: 2rem;
		}
	}
</style>
